# MERGED template — review, then rename over the top of .env.example.
#
# Your real .env is untouched. After renaming this file, copy the CHATBOT
# section below into your own .env and fill in the OpenAI key — the backend
# settings you already have are unchanged.
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored. .env.example is committed, and holds placeholders only.

# ===========================================================================
# BACKEND — unchanged from your existing .env.example
# ===========================================================================

# Atlas connection string: Atlas dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cwac

# Any long random string. Regenerate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every issued token.
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call this API from a browser: the staff
# portal on 5000 and the public website on 3000.
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# ===========================================================================
# CHATBOT — add these to your .env
# ===========================================================================

# From https://platform.openai.com/api-keys — starts with "sk-proj-".
# Treat it like a password: it is billable and grants full API access.
# Left as the placeholder, the chatbot runs on rule-based replies only and
# never calls OpenAI — it does not crash, it degrades.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Confirm against https://openai.com/api/pricing/ before committing to one.
OPENAI_MODEL=gpt-4o-mini

# Patients are waiting on a WhatsApp reply, so fail fast rather than hang.
# Twilio gives up on the webhook after 15 seconds and OpenAI calls are not
# retried, so keep this at 10 or lower.
OPENAI_TIMEOUT_SECONDS=10

# Caps cost per call and keeps replies WhatsApp-length.
OPENAI_MAX_OUTPUT_TOKENS=300

# Set to "false" to force rule-based replies only, even with a valid key.
LLM_FALLBACK_ENABLED=true

# In the booking flow, let OpenAI read symptoms from the patient's own words
# instead of only matching known keywords. Needs OPENAI_API_KEY. If OpenAI fails
# or is slow, the keyword matcher is used instead. "false" means keywords only.
OPENAI_SYMPTOM_EXTRACTION=true

# --- ML symptom classifier (ENG-1660) ---
# Inactive until the outsourced model is registered at startup, whatever these
# say. Set to "false" to bypass that layer even once it exists.
CLASSIFIER_ENABLED=true

# Predictions below this confidence are discarded and fall through to OpenAI.
CLASSIFIER_MIN_CONFIDENCE=0.6

# The model will not act on fewer symptoms than this. One symptom alone is
# unreliable: "sweating" by itself scores 74% heart attack.
CLASSIFIER_MIN_SYMPTOMS=2

# Probability of a heart attack or brain hemorrhage at which the bot tells the
# patient to get emergency help instead of booking. Measured: every real
# emergency tested scored at least 0.56, so 0.4 missed none. Lower this rather
# than raise it.
CLASSIFIER_EMERGENCY_THRESHOLD=0.4

# ===========================================================================
# TWILIO WHATSAPP WEBHOOK (ENG-1653)
# ===========================================================================

# Twilio console -> Account Info -> Auth Token. A secret: it is what proves an
# incoming webhook request really came from Twilio. Unlike the OpenAI key,
# leaving this unset does NOT degrade gracefully — the webhook refuses every
# request, because without it anyone who finds the URL could post fake patient
# messages.
TWILIO_AUTH_TOKEN=

# Set to true ONLY to test locally with curl before the token arrives. It turns
# off signature checking entirely, so never set it anywhere reachable from the
# internet. Defaults to false so a deploy that forgets the token fails closed.
TWILIO_SKIP_SIGNATURE_CHECK=false

# Usually leave empty. Twilio signs the exact public URL it called; behind
# ngrok or Render the app may see a different one and every signature fails.
# If that happens, paste the full public webhook URL here, e.g.
#   https://your-service.onrender.com/whatsapp/webhook
TWILIO_WEBHOOK_URL=
